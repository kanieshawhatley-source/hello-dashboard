# Neon Postgres connection string (Vercel adds this automatically when you
# attach a Neon database; copy it here for local development).
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Password used to unlock the dashboard.
DASHBOARD_PASSWORD="choose-a-strong-password"

# Random secret used to sign the session cookie.
# Generate one with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
AUTH_SECRET="replace-with-a-long-random-string"

# IANA timezone used to decide what "today" means for due dates and habit
# streaks. Vercel runs in UTC, so set this or streaks will roll over at the
# wrong hour. Examples: America/New_York, Europe/London, Asia/Tokyo
APP_TIMEZONE="UTC"
